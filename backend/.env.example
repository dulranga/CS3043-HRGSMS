# PostgreSQL Connection URL
# Format: postgresql://username:password@localhost:5432/database_name
PG_URL=postgresql://user:password@localhost:5432/skynest_hrgsms

# Server Port (optional, defaults to 4000)
PORT=4000

# Session signing secret (required, at least 32 characters; never commit a real value).

SESSION_SECRET=
# Set to false only for plain-HTTP local development (rejected in production).
# SESSION_COOKIE_SECURE=false
# Absolute session lifetime in hours (optional, defaults to 12). The idle timeout
# is the system_config key session_idle_timeout_minutes (default 30).
# SESSION_ABSOLUTE_HOURS=12
