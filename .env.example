# Docker Compose configuration for SkyNest HRGSMS.
# Copy to `.env` (git-ignored) and adjust before `docker compose up`:
#   cp .env.example .env

# --- PostgreSQL 18 ---------------------------------------------------------
# Also used to build the backend's PG_URL, so keep them in sync.
POSTGRES_USER=skynest
POSTGRES_PASSWORD=skynest
POSTGRES_DB=skynest_hrgsms
# Host port mapped to Postgres (change if 5432 is already in use).
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
# Required. At least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
# Keep true for http://localhost or HTTPS. Set to false ONLY to sign in over
# plain HTTP from a non-localhost host — this also requires NODE_ENV=development
# (the app refuses insecure cookies in production).
SESSION_COOKIE_SECURE=true
NODE_ENV=production
# Absolute session lifetime in hours (optional, defaults to 12).
SESSION_ABSOLUTE_HOURS=12
BACKEND_PORT=4000

# --- Frontend --------------------------------------------------------------
# Open the app at http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080
# Backend the frontend preview server reverse-proxies /api to. Defaults to the
# bundled backend service; set an absolute URL to target a hosted backend, e.g.
VITE_BACKEND_URL=https://backend.example.com
# VITE_BACKEND_URL=http://backend:4000
 