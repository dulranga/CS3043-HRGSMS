# Backend the Vite dev server proxies the frontend's same-origin `/api` calls to.
# The browser keeps calling `/api` on its own origin (so the HTTP-only session
# cookie is sent); the dev server forwards those requests to this URL.
#
# Local backend (default when unset):
VITE_BACKEND_URL=http://localhost:4000
#
# Deployed backend:
# VITE_BACKEND_URL=https://backend.thankfulrock-4a2c7a60.indonesiacentral.azurecontainerapps.io

# Hosts the dev/preview server accepts in the Host header (DNS-rebinding
# protection). Defaults to the Azure Container Apps domain; set "true" to allow
# any host, or a comma-separated list for a custom domain.
VITE_ALLOWED_HOSTS=.azurecontainerapps.io

# Copy this file to `.env.local` and edit it, then restart `npm run dev`.
